# Needed for `npm run digest`. In GitHub Actions this is a repository secret.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
CLAUDE_MODEL=claude-sonnet-5-5
MONTHLY_BUDGET_USD=5
MAX_ITEMS_PER_RUN=60
BATCH_SIZE=15

# Needed only for `npm run digest -- send digests/<date>.md`.
RESEND_API_KEY=
DIGEST_TO=
DIGEST_FROM=
